<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="560.0" prefWidth="460.0" styleClass="tela" stylesheets="@atm.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.atm.cliente.controller.ValorController">
   <children>
      <Label fx:id="titulo" styleClass="titulo" text="Saque" />
      <Label fx:id="contaInfo" styleClass="subtitulo" text="Conta" />
      <Region prefHeight="8.0" />
      <Label styleClass="rotulo-campo" text="Valores rápidos" />
      <HBox spacing="8.0">
         <children>
            <Button mnemonicParsing="false" onAction="#valorRapido" prefWidth="92.0" styleClass="botao-valor" text="R$ 20" userData="20" />
            <Button mnemonicParsing="false" onAction="#valorRapido" prefWidth="92.0" styleClass="botao-valor" text="R$ 50" userData="50" />
            <Button mnemonicParsing="false" onAction="#valorRapido" prefWidth="92.0" styleClass="botao-valor" text="R$ 100" userData="100" />
            <Button mnemonicParsing="false" onAction="#valorRapido" prefWidth="92.0" styleClass="botao-valor" text="R$ 200" userData="200" />
         </children>
      </HBox>
      <Label styleClass="rotulo-campo" text="Valor (R$)" />
      <TextField fx:id="campoValor" onAction="#confirmar" promptText="0,00" />
      <Region prefHeight="8.0" />
      <Button fx:id="botaoConfirmar" mnemonicParsing="false" onAction="#confirmar" styleClass="botao-principal" text="Confirmar" />
      <Button mnemonicParsing="false" onAction="#voltar" styleClass="botao-secundario" text="Voltar" />
      <Label fx:id="mensagem" styleClass="mensagem-erro" />
   </children>
</VBox>
