<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="560.0" prefWidth="460.0" styleClass="tela" stylesheets="@atm.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.atm.cliente.controller.ExtratoController">
   <children>
      <Label styleClass="titulo" text="Extrato" />
      <Label fx:id="contaInfo" styleClass="subtitulo" text="Conta" />
      <Label styleClass="rotulo-campo" text="Saldo atual" />
      <Label fx:id="valorSaldo" styleClass="valor-destaque" text="R$ 0,00" />
      <TableView fx:id="tabela" prefHeight="200.0" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colunaData" prefWidth="112.0" sortable="false" text="Data" />
            <TableColumn fx:id="colunaTipo" prefWidth="70.0" sortable="false" text="Tipo" />
            <TableColumn fx:id="colunaValor" prefWidth="104.0" sortable="false" text="Valor" />
            <TableColumn fx:id="colunaSaldo" prefWidth="104.0" sortable="false" text="Saldo" />
         </columns>
         <placeholder>
            <Label text="Nenhuma transação nesta conta." />
         </placeholder>
      </TableView>
      <Button mnemonicParsing="false" onAction="#voltar" styleClass="botao-principal" text="Voltar ao menu" />
   </children>
</VBox>
