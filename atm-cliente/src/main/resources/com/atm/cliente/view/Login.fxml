<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="560.0" prefWidth="460.0" styleClass="tela" stylesheets="@atm.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.atm.cliente.controller.LoginController">
   <children>
      <Label styleClass="titulo" text="Caixa Eletrônico" />
      <Label styleClass="subtitulo" text="Insira o cartão e digite sua senha" />
      <Region prefHeight="20.0" />
      <Label styleClass="rotulo-campo" text="Número do cartão" />
      <TextField fx:id="campoCartao" onAction="#entrar" promptText="0000000000000000" />
      <Label styleClass="rotulo-campo" text="Senha" />
      <PasswordField fx:id="campoSenha" onAction="#entrar" promptText="••••" />
      <Region prefHeight="8.0" />
      <Button fx:id="botaoEntrar" mnemonicParsing="false" onAction="#entrar" styleClass="botao-principal" text="Entrar" />
      <Label fx:id="mensagem" styleClass="mensagem-erro" />
   </children>
</VBox>
